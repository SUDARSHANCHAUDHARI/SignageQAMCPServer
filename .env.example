# AI Provider (optional — all tools work without this)
# Set to "claude" or "openai" to enable AI-enhanced summaries
AI_PROVIDER=claude

# Anthropic API key (required if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_key_here

# OpenAI API key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_key_here

# Directory for captured screenshots
SCREENSHOTS_DIR=./screenshots
