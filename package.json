{
  "name": "signageqa-mcp-server",
  "version": "0.1.0",
  "description": "MCP server giving AI agents tools to inspect and diagnose digital signage systems",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
